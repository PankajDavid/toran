# Copy to .env for local use. Never commit real values.
# In production, set these in Railway → service → Variables.
PORT=8080

# Gemini (Google AI Studio key). Without it the app runs with offline fallbacks.
GEMINI_API_KEY=
# Optional model overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Google Maps Platform key, restricted to "Places API (New)". Without it, vendor search is off.
GOOGLE_MAPS_API_KEY=
